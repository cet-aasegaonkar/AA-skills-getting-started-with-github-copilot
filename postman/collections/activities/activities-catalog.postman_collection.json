{
  "info": {
    "_postman_id": "d94ca2fd-7ef7-4532-b9a7-a32262953caf",
    "name": "Activities Catalog",
    "description": "Feature-focused Postman collection for validating the activities catalog endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Read Activities",
      "item": [
        {
          "name": "Get all activities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/activities",
            "description": "Positive API test for retrieving the activities catalog."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is below threshold', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseTime')));",
                  "});",
                  "",
                  "pm.test('Content-Type header is JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const activitySchema = {",
                  "    type: 'object',",
                  "    minProperties: 1,",
                  "    additionalProperties: false,",
                  "    patternProperties: {",
                  "        '.*': {",
                  "            type: 'object',",
                  "            required: ['description', 'schedule', 'max_participants', 'participants'],",
                  "            properties: {",
                  "                description: { type: 'string' },",
                  "                schedule: { type: 'string' },",
                  "                max_participants: { type: 'integer', minimum: 1 },",
                  "                participants: {",
                  "                    type: 'array',",
                  "                    items: { type: 'string' }",
                  "                }",
                  "            }",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "pm.test('Response body matches the expected JSON schema', function () {",
                  "    pm.response.to.have.jsonSchema(activitySchema);",
                  "});",
                  "",
                  "pm.test('Response body contains at least one activity', function () {",
                  "    pm.expect(Object.keys(response).length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Participant counts stay within the configured maximum', function () {",
                  "    Object.values(response).forEach(function (activity) {",
                  "        pm.expect(activity.participants.length).to.be.at.most(activity.max_participants);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Boundary check for activity capacity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/activities",
            "description": "Boundary-oriented API test that confirms participant arrays never exceed the declared capacity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Boundary validation returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Every activity reserves at least one slot for participants', function () {",
                  "    Object.values(response).forEach(function (activity) {",
                  "        pm.expect(activity.max_participants).to.be.above(0);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Each participant list length stays on or below the boundary', function () {",
                  "    Object.values(response).forEach(function (activity) {",
                  "        pm.expect(activity.participants.length).to.be.at.most(activity.max_participants);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "featureName",
      "value": "activities"
    }
  ]
}
