{
  "info": {
    "_postman_id": "2545ab81-0d56-43b3-84ec-816fe13f9b04",
    "name": "Activity Signups",
    "description": "Feature-focused Postman collection for validating activity sign-up scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Positive Cases",
      "item": [
        {
          "name": "Sign up a new student for Chess Club",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/activities/Chess%20Club/signup?email={{newStudentEmail}}",
            "description": "Positive API test that signs up a new student for an existing activity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Positive sign-up returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type header remains JSON', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Sign-up response time is below threshold', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseTime')));",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Response body confirms the student and activity', function () {",
                  "    pm.expect(response.message).to.include(pm.environment.get('newStudentEmail'));",
                  "    pm.expect(response.message).to.include('Chess Club');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Reject an unknown activity",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/activities/Unknown%20Club/signup?email={{newStudentEmail}}",
            "description": "Negative API test for a sign-up request that targets an unknown activity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown activities return 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Response body explains the failure', function () {",
                  "    pm.expect(response.detail).to.eql('Activity not found');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Boundary Cases",
      "item": [
        {
          "name": "Accept a long but valid email alias",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/activities/Programming%20Class/signup?email={{boundaryStudentEmail}}",
            "description": "Boundary-oriented API test using a long but valid-looking email alias."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Boundary sign-up avoids server errors', function () {",
                  "    pm.expect(pm.response.code).to.not.eql(500);",
                  "});",
                  "",
                  "pm.test('Boundary sign-up returns a success response', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Boundary response body includes the submitted email alias', function () {",
                  "    pm.expect(response.message).to.include(pm.environment.get('boundaryStudentEmail'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Security Cases",
      "item": [
        {
          "name": "SQL injection style activity name",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/activities/%27%20OR%20%271%27%3D%271/signup?email={{newStudentEmail}}",
            "description": "Security-focused API test that sends an injection-style activity name and verifies the service fails safely."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Injection-style activity names do not crash the API', function () {",
                  "    pm.expect(pm.response.code).to.not.eql(500);",
                  "});",
                  "",
                  "pm.test('Unknown injected activity still returns 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS style email payload",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/activities/Gym%20Class/signup?email=%3Cscript%3Ealert(1)%3C%2Fscript%3E%40example.com",
            "description": "Security-focused API test that sends an encoded XSS-style email payload and verifies the response stays JSON and avoids 5xx errors."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Security payload does not cause a server error', function () {",
                  "    pm.expect(pm.response.code).to.not.eql(500);",
                  "});",
                  "",
                  "pm.test('Security payload response keeps a JSON content type', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "featureName",
      "value": "signups"
    }
  ]
}
